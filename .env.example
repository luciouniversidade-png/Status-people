# Conexão com o PostgreSQL (Neon, Supabase ou local). Exemplo Neon:
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"
# Segredo da sessão (qualquer texto longo e aleatório, 32+ caracteres)
# mínimo 32 caracteres aleatórios; sem ele o sistema não aceita sessões
AUTH_SECRET="troque-por-um-texto-longo-e-aleatorio-com-mais-de-32-caracteres"
# Token usado UMA vez para criar as tabelas e o usuário inicial em /api/setup?token=...
# mínimo 16 caracteres; depois da instalação, /api/setup exige também sessão de Direção/RH
SETUP_TOKEN="troque-por-outro-texto-aleatorio"
# Senha inicial do usuário rh@colegiostatus (troque no primeiro acesso)
# mínimo 10 caracteres; senha inicial de rh@colegiostatus (troque no primeiro acesso e ative o 2FA)
ADMIN_PASSWORD="Status2026!"

# --- Opcionais ---
# Endereço público do sistema (usado nos links dos e-mails), ex.: https://status-people.vercel.app
APP_URL=""
# Notificações por e-mail via Resend (resend.com). Sem estas duas variáveis, o sistema simplesmente não envia e-mails.
RESEND_API_KEY=""
MAIL_FROM="STATUS People <rh@seudominio.com.br>"

# IA (opcional): chave da Anthropic e modelo — usada pelo People AI e pelos rascunhos com fontes do Desempenho. Sem a chave, os recursos de IA ficam indisponíveis e nada é enviado para fora.
AI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# WhatsApp oficial (Meta Cloud API) — opcional. Sem isso, as mensagens abrem no WhatsApp do celular com o texto pronto.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Opcional — Modo TV em tela fixa sem login: /tv?token=VALOR (use um valor longo e aleatório)
TV_TOKEN=

# Opcional — atualização automática do banco na subida do servidor (padrão: ligada). Use 0 para desligar.
# AUTO_MIGRAR=0
